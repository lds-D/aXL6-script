local Players = game:GetService("Players")
local player = Players.LocalPlayer
if not player then
    repeat task.wait() until Players.LocalPlayer
    player = Players.LocalPlayer
end

local whitelist = {"aXL6_NB"}
local allowed = false
for _, name in ipairs(whitelist) do
    if player.Name == name then
        allowed = true
        break
    end
end

if allowed then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/lds-D/aXL6-script/refs/heads/main/aXL6%E8%84%9A%E6%9C%AC%5B%E4%B8%BB%E4%BD%93%5D"))()
else
    CoreGui:SetCore("SendNotification", {
    Title = "NO白名单",
    Text = "请找作者要白名单",
    Duration = 5, 
})
end
